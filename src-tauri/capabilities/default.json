{
  "$schema": "../../node_modules/@tauri-apps/cli/schema.json",
  "identifier": "default",
  "description": "Default capability for Gerenciador de Risco",
  "windows": ["main"],
  "permissions": [
    "window:allow-close",
    "window:allow-hide",
    "window:allow-show",
    "window:allow-set-title",
    "core:allow-calculate-position-size",
    "core:allow-plan-trade",
    "core:allow-close-trade",
    "core:allow-monthly-report",
    "core:allow-year-report"
  ]
}
